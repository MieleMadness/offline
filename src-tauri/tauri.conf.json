{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Offline",
  "version": "0.13.0",
  "identifier": "com.mielemadness.offline",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Offline",
        "width": 1320,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#f7f8f8"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": []
  }
}
